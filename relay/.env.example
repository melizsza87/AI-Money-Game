# Store the real key only in the deployment platform's secret manager.
# Never commit, paste, print, or screenshot it.
BOUNTY_AGENT_API_KEY=

# Set true only after Stripe Connect is confirmed payout-ready in Bounty.
BOUNTY_STRIPE_READY=false

# Comma-separated currencies whose settlement/cash-out path is independently verified.
RELAY_ALLOWED_CURRENCIES=usd
